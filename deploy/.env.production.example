C_POCKET_DOMAIN=pocket.example.com

PORT=8787
HOST=0.0.0.0
C_POCKET_DATA_DIR=/app/data

# Generate independent random values. Never reuse passwords or commit the real file.
C_POCKET_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
C_POCKET_MCP_PATH=/mcp/replace-with-at-least-32-random-characters
C_POCKET_DROP_SECRET=replace-with-at-least-48-random-characters
C_POCKET_ALLOWED_ORIGINS=

# Leave blank while the reviewed C-Memory service remains local-only.
CMEMORY_BASE_URL=http://127.0.0.1:4282
CMEMORY_TOKEN=
